SELECT
	asset,
	uid,
	disk,
	key,
	filename,
	mime,
	bytes,
	width,
	height,
	hash,
	meta,
	created,
	changed,
	-- Windowed before LIMIT applies: every row carries the full match count.
	count(*) OVER () AS total
FROM
	/*:cms.prefix:*/assets
WHERE
	1 = 1
<?php if (isset($kinds)) : ?>
	-- Filter vocabulary: splits classify()'s `file` into audio/document.
	-- Keep the prefixes in sync with Asset::classify() and counts.tpql.
	AND (
		CASE
			WHEN mime LIKE 'image/%' THEN 'image'
			WHEN mime LIKE 'video/%' THEN 'video'
			WHEN mime LIKE 'audio/%' THEN 'audio'
			ELSE 'document'
		END
	) IN (SELECT jsonb_array_elements_text(:kinds::jsonb))
<?php endif ?>
<?php if (isset($q)) : ?>
	AND filename ILIKE :q
<?php endif ?>
<?php if (isset($since)) : ?>
	AND created >= :since
<?php endif ?>
<?php if (isset($uids)) : ?>
	AND uid IN (SELECT jsonb_array_elements_text(:uids::jsonb))
<?php endif ?>
ORDER BY
	created DESC,
	asset DESC
<?php if (isset($limit)) : ?>
LIMIT :limit
<?php endif ?>
<?php if (isset($offset)) : ?>
OFFSET :offset
<?php endif ?>;
