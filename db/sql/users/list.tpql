SELECT
	u.usr,
	u.uid,
	u.type,
	u.username,
	u.email,
	u.password,
	array_to_json(u.roles) AS roles,
	u.active,
	u.panel_locale,
	u.data,
	u.created,
	u.changed,
	u.deleted
FROM
	/*:cms.prefix:*/users u
WHERE
	u.deleted IS NULL
	AND u.type != 'system'
<?php if (isset($type)) : ?>
	AND u.type = :type
<?php endif ?>
<?php if (isset($search)) : ?>
	AND (
		u.email ILIKE :search
		OR u.username ILIKE :search
		OR u.data->>'name' ILIKE :search
	)
<?php endif ?>
ORDER BY
	lower(COALESCE(NULLIF(u.data->>'name', ''), u.username, u.email)),
	u.usr
LIMIT :limit OFFSET :offset;
