SELECT
	n.node,
	n.uid,
	h.handle,
	np.uid AS parent,
	n.published,
	n.hidden,
	n.locked,
	n.created,
	n.changed,
	n.deleted,
<?php if (isset($working) && $working) : ?>
	coalesce(d.content, n.content) AS content,
	coalesce(d.settings, '{}'::jsonb) AS draft_settings,
<?php else: ?>
	n.content,
<?php endif ?>
	n.title,
<?php if (isset($fulltext)) : ?>
<?php if (isset($fulltext_words)) : ?>
	GREATEST(
		ts_rank_cd(ft.document, websearch_to_tsquery(:search_config::regconfig, :fulltext)),
		<?= $fulltext_partial_score ?> + <?= $fulltext_title_score ?> * (0
<?php foreach ($fulltext_inside_words as $i) : ?>
			+ (/*:cms.prefix:*/fulltext_fold((SELECT string_agg(value, ' ') FROM jsonb_each_text(n.title)))
				LIKE /*:cms.prefix:*/fulltext_fold(:fulltext_pattern_<?= $i ?>))::int
<?php endforeach ?>
		)::float / <?= max(1, count($fulltext_inside_words)) ?>
	) AS search_score,
<?php else: ?>
	ts_rank_cd(ft.document, websearch_to_tsquery(:search_config::regconfig, :fulltext)) AS search_score,
<?php endif ?>
<?php if (!empty($fulltext_inside_words)) : ?>
	ts_headline(:search_config::regconfig, ft.source, websearch_to_tsquery(:search_config::regconfig, :fulltext) || coalesce((
		SELECT websearch_to_tsquery(:search_config::regconfig, string_agg(DISTINCT word, ' OR '))
		FROM regexp_split_to_table(ft.source, '[[:space:][:punct:]]+') AS word
		WHERE false
<?php foreach ($fulltext_inside_words as $i) : ?>
			OR /*:cms.prefix:*/fulltext_fold(word) LIKE /*:cms.prefix:*/fulltext_fold(:fulltext_pattern_<?= $i ?>)
<?php endforeach ?>
	), ''::tsquery),
<?php else: ?>
	ts_headline(:search_config::regconfig, ft.source, websearch_to_tsquery(:search_config::regconfig, :fulltext),
<?php endif ?>
		'StartSel=' || chr(1) || ', StopSel=' || chr(2) || ', MaxWords=35, MinWords=15, MaxFragments=2, FragmentDelimiter=" … "') AS search_headline,
<?php endif ?>
	d.node IS NOT NULL AS has_draft,
	d.created AS draft_created,
	d.changed AS draft_changed,
	d.editor AS draft_editor,
	coalesce(ud.data->>'name', ud.username, ud.email) AS draft_editor_name,
	t.handle AS type_handle,
	uc.uid AS creator_uid,
	uc.email AS creator_email,
	uc.username AS creator_username,
	uc.data AS creator_data,
	ue.uid AS editor_uid,
	ue.email AS editor_email,
	ue.username AS editor_username,
	ue.data AS editor_data,
	coalesce(
		jsonb_object_agg(sup.locale, sup.path)
			FILTER (WHERE up.inactive IS NULL AND sup.path IS NOT NULL),
		'{}')::jsonb AS paths
FROM
	/*:cms.prefix:*/nodes n
	INNER JOIN /*:cms.prefix:*/types t USING(type)
<?php if (isset($fulltext)) : ?>
	INNER JOIN /*:cms.prefix:*/full_text ft ON ft.node = n.node AND ft.locale = :search_locale
<?php endif ?>
	LEFT JOIN /*:cms.prefix:*/node_handles h ON
		h.node = n.node
	LEFT JOIN /*:cms.prefix:*/nodes np ON
		np.node = n.parent
	LEFT JOIN /*:cms.prefix:*/drafts d ON
		d.node = n.node
	LEFT JOIN /*:cms.prefix:*/users ud ON
		ud.usr = d.editor
	INNER JOIN /*:cms.prefix:*/users uc ON
		uc.usr = n.creator
	INNER JOIN /*:cms.prefix:*/users ue ON
		ue.usr = n.editor
	LEFT JOIN /*:cms.prefix:*/url_paths up ON
		up.node = n.node
	LEFT JOIN (
		SELECT
			sup.node,
			sup.path,
			sup.locale
		FROM
			/*:cms.prefix:*/url_paths sup
		WHERE
			sup.inactive IS NULL
	) sup ON sup.node = n.node
WHERE
	1 = 1
<?php if (isset($fulltext)) : ?>
	AND (
		ft.document @@ websearch_to_tsquery(:search_config::regconfig, :fulltext)
<?php if (isset($fulltext_words)) : ?>
		OR (TRUE
<?php foreach ($fulltext_words as $i => $word) : ?>
			AND <?= $word['negated'] ? 'NOT ' : '' ?>(
<?php if (!$word['negated']) : ?>
				numnode(plainto_tsquery(:search_config::regconfig, :fulltext_word_<?= $i ?>)) = 0 OR
<?php endif ?>
				ft.document @@ plainto_tsquery(:search_config::regconfig, :fulltext_word_<?= $i ?>)
<?php if ($word['inside']) : ?>
				OR /*:cms.prefix:*/fulltext_fold(ft.source) LIKE /*:cms.prefix:*/fulltext_fold(:fulltext_pattern_<?= $i ?>)
<?php endif ?>
			)
<?php endforeach ?>
		)
<?php endif ?>
	)
<?php endif ?>
<?php if (isset($active_url) && $active_url) : ?>
	AND (<?= $routable ?>)
	AND EXISTS (
		SELECT FROM /*:cms.prefix:*/url_paths public_path
		WHERE public_path.node = n.node AND public_path.inactive IS NULL
			AND public_path.path <> ''
			AND public_path.locale IN :url_locales
	)
<?php endif ?>
<?php if (isset($uid)) : ?>
	AND n.uid = :uid
<?php endif ?>
<?php if (isset($handle)) : ?>
	AND h.handle = :handle
<?php endif ?>
<?php if (isset($deleted)) : ?>
<?php if ($deleted) : ?>
	AND n.deleted IS NOT NULL
<?php else: ?>
	AND n.deleted IS NULL
<?php endif ?>
<?php endif ?>
<?php if (isset($published)) : ?>
	AND n.published = :published
<?php endif ?>
<?php if (isset($hidden)) : ?>
	AND n.hidden = :hidden
<?php endif ?>
<?php if (isset($condition) && !empty(trim($condition))) : ?>
	AND (<?= $condition ?>)
<?php endif ?>
<?php if (isset($path)) : ?>
	AND up.path = :path
	AND up.inactive IS NULL
<?php endif ?>

GROUP BY
<?php if (isset($fulltext)) : ?>
	ft.node, ft.locale,
<?php endif ?>
	n.node,
	d.node,
	ud.data,
	ud.username,
	ud.email,
	np.uid,
	uc.uid,
	uc.email,
	uc.username,
	uc.data,
	ue.uid,
	ue.email,
	ue.username,
	ue.data,
	t.handle,
	h.handle
<?php if (isset($order)) : ?>
ORDER BY <?= $order ?>
<?php endif ?>
<?php if (isset($limit)) : ?>

LIMIT :limit
<?php endif ?>
<?php if (isset($offset)) : ?>

OFFSET :offset
<?php endif ?>;
