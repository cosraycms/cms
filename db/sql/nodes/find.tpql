SELECT
	n.node,
	n.uid,
	n.revision,
	h.handle,
	np.uid AS parent,
	p.published,
	p.hidden,
	n.locked,
	n.created,
	n.changed,
	n.edited,
	n.deleted,
<?php if (isset($working) && $working && isset($autosave)) : ?>
	coalesce(a.content, CASE WHEN <?= $drafted ?? 'TRUE' ?> THEN dr.content END, n.content) AS content,
	coalesce(CASE WHEN <?= $drafted ?? 'TRUE' ?> THEN dr.settings END, '{}'::jsonb) AS draft_settings,
<?php elseif (isset($working) && $working) : ?>
	coalesce(CASE WHEN <?= $drafted ?? 'TRUE' ?> THEN dr.content END, n.content) AS content,
	coalesce(CASE WHEN <?= $drafted ?? 'TRUE' ?> THEN dr.settings END, '{}'::jsonb) AS draft_settings,
<?php else: ?>
	n.content,
<?php endif ?>
	n.title,
<?php if (isset($fulltext)) : ?>
<?php if (isset($fulltext_words)) : ?>
<?php // LIKE patterns are escaped after the fold, which maps fullwidth ％ and ＿ to % and _. ?>
	GREATEST(
		ts_rank_cd(ft.document, websearch_to_tsquery(:search_config::regconfig, :fulltext)),
		<?= $fulltext_partial_score ?> + <?= $fulltext_title_score ?> * (0
<?php foreach ($fulltext_inside_words as $i) : ?>
			+ (/*:cms.prefix:*/fulltext_fold((SELECT string_agg(value, ' ') FROM jsonb_each_text(n.title)))
				LIKE '%' || regexp_replace(/*:cms.prefix:*/fulltext_fold(:fulltext_word_<?= $i ?>), '([\\%_])', '\\\1', 'g') || '%')::int
<?php endforeach ?>
		)::float / <?= max(1, count($fulltext_inside_words)) ?>
	) AS search_score,
<?php else: ?>
	ts_rank_cd(ft.document, websearch_to_tsquery(:search_config::regconfig, :fulltext)) AS search_score,
<?php endif ?>
<?php if (!empty($fulltext_inside_words)) : ?>
	ts_headline(:search_config::regconfig, ft.source, websearch_to_tsquery(:search_config::regconfig, :fulltext) || coalesce((
		SELECT websearch_to_tsquery(:search_config::regconfig, string_agg(DISTINCT word, ' OR '))
		FROM regexp_split_to_table(ft.source, '[[:space:][:punct:]]+') AS word
		WHERE false
<?php foreach ($fulltext_inside_words as $i) : ?>
			OR /*:cms.prefix:*/fulltext_fold(word) LIKE '%' || regexp_replace(/*:cms.prefix:*/fulltext_fold(:fulltext_word_<?= $i ?>), '([\\%_])', '\\\1', 'g') || '%'
<?php endforeach ?>
	), ''::tsquery),
<?php else: ?>
	ts_headline(:search_config::regconfig, ft.source, websearch_to_tsquery(:search_config::regconfig, :fulltext),
<?php endif ?>
		'StartSel=' || chr(1) || ', StopSel=' || chr(2) || ', MaxWords=35, MinWords=15, MaxFragments=2, FragmentDelimiter=" … "') AS search_headline,
<?php endif ?>
<?php if (isset($mine)) : ?>
	(SELECT m.changed FROM /*:cms.prefix:*/edits m WHERE m.node = n.node AND m.editor = :mine) AS mine_changed,
	(SELECT m.base FROM /*:cms.prefix:*/edits m WHERE m.node = n.node AND m.editor = :mine) AS mine_base,
<?php endif ?>
	d.node IS NOT NULL AS has_draft,
	d.revision AS draft_revision,
	d.base AS draft_base,
	d.created AS draft_created,
	dr.created AS draft_changed,
	dr.editor AS draft_editor,
	coalesce(ud.data->>'name', ud.username, ud.email) AS draft_editor_name,
	coalesce(ua.data->>'name', ua.username, ua.email) AS applier_name,
	t.handle AS type_handle,
	uc.uid AS creator_uid,
	uc.email AS creator_email,
	uc.username AS creator_username,
	uc.data AS creator_data,
	ue.uid AS editor_uid,
	ue.email AS editor_email,
	ue.username AS editor_username,
	ue.data AS editor_data,
	coalesce(
		jsonb_object_agg(sup.locale, sup.path)
			FILTER (WHERE up.inactive IS NULL AND sup.path IS NOT NULL),
		'{}')::jsonb AS paths
FROM
	/*:cms.prefix:*/nodes n
	INNER JOIN /*:cms.prefix:*/types t USING(type)
<?php if (isset($fulltext)) : ?>
	INNER JOIN /*:cms.prefix:*/full_text ft ON ft.node = n.node AND ft.locale = :search_locale
<?php endif ?>
	LEFT JOIN /*:cms.prefix:*/publications p ON
		p.node = n.node
	LEFT JOIN /*:cms.prefix:*/handles h ON
		h.node = n.node
	LEFT JOIN /*:cms.prefix:*/nodes np ON
		np.node = n.parent
	LEFT JOIN /*:cms.prefix:*/drafts d ON
		d.node = n.node
	LEFT JOIN /*:cms.prefix:*/revisions dr ON
		dr.revision = d.revision
	LEFT JOIN /*:cms.prefix:*/revisions mr ON
		mr.revision = n.revision
<?php // Who made the main revision main: it may have been drafted by someone else. ?>
	LEFT JOIN LATERAL (
		SELECT
			e.actor
		FROM
			/*:cms.prefix:*/events e
		WHERE
			e.revision = n.revision
			AND e.action IN ('created', 'saved', 'applied')
		ORDER BY
			e.event DESC
		LIMIT 1
	) ea ON true
	LEFT JOIN /*:cms.prefix:*/users ua ON
		ua.usr = ea.actor
<?php if (isset($working) && $working && isset($autosave)) : ?>
	LEFT JOIN /*:cms.prefix:*/edits a ON
		a.node = n.node AND a.editor = :autosave
<?php endif ?>
	LEFT JOIN /*:cms.prefix:*/users ud ON
		ud.usr = dr.editor
	INNER JOIN /*:cms.prefix:*/users uc ON
		uc.usr = n.creator
	LEFT JOIN /*:cms.prefix:*/users ue ON
		ue.usr = mr.editor
	LEFT JOIN /*:cms.prefix:*/url_paths up ON
		up.node = n.node
	LEFT JOIN (
		SELECT
			sup.node,
			sup.path,
			sup.locale
		FROM
			/*:cms.prefix:*/url_paths sup
		WHERE
			sup.inactive IS NULL
	) sup ON sup.node = n.node
WHERE
	1 = 1
<?php if (isset($fulltext)) : ?>
	AND (
		ft.document @@ websearch_to_tsquery(:search_config::regconfig, :fulltext)
<?php if (isset($fulltext_words)) : ?>
<?php // Column-free guards fold to constants because PDO inlines the values and the functions are immutable; otherwise they would block both indexes. ?>
		OR (numnode(websearch_to_tsquery(:search_config::regconfig, :fulltext)) > 0
<?php foreach ($fulltext_words as $i => $word) : ?>
			AND <?= $word['negated'] ? 'NOT ' : '' ?>(
<?php if (!$word['negated']) : ?>
				numnode(plainto_tsquery(:search_config::regconfig, :fulltext_word_<?= $i ?>)) = 0 OR
<?php endif ?>
				ft.document @@ plainto_tsquery(:search_config::regconfig, :fulltext_word_<?= $i ?>)
<?php if ($word['inside']) : ?>
				OR /*:cms.prefix:*/fulltext_fold(ft.source) LIKE '%' || regexp_replace(/*:cms.prefix:*/fulltext_fold(:fulltext_word_<?= $i ?>), '([\\%_])', '\\\1', 'g') || '%'
<?php endif ?>
			)
<?php endforeach ?>
		)
<?php endif ?>
	)
<?php endif ?>
<?php if (isset($active_url) && $active_url) : ?>
	AND (<?= $routable ?>)
	AND EXISTS (
		SELECT FROM /*:cms.prefix:*/url_paths public_path
		WHERE public_path.node = n.node AND public_path.inactive IS NULL
			AND public_path.path <> ''
			AND public_path.locale IN :url_locales
	)
<?php endif ?>
<?php if (isset($uid)) : ?>
	AND n.uid = :uid
<?php endif ?>
<?php if (isset($handle)) : ?>
	AND h.handle = :handle
<?php endif ?>
<?php if (isset($deleted)) : ?>
<?php if ($deleted) : ?>
	AND n.deleted IS NOT NULL
<?php else: ?>
	AND n.deleted IS NULL
<?php endif ?>
<?php endif ?>
<?php if (isset($published)) : ?>
<?php // A node without a publication row, a record, is neither published nor hidden. ?>
	AND <?= $published ? 'p.published' : 'p.published IS NOT TRUE' ?>

<?php endif ?>
<?php if (isset($hidden)) : ?>
	AND <?= $hidden ? 'p.hidden' : 'p.hidden IS NOT TRUE' ?>

<?php endif ?>
<?php if (isset($condition) && !empty(trim($condition))) : ?>
	AND (<?= $condition ?>)
<?php endif ?>
<?php if (isset($path)) : ?>
	AND up.path = :path
	AND up.inactive IS NULL
<?php endif ?>

GROUP BY
<?php if (isset($fulltext)) : ?>
	ft.node, ft.locale,
<?php endif ?>
	n.node,
	p.node,
	d.node,
	dr.revision,
	ua.usr,
<?php if (isset($working) && $working && isset($autosave)) : ?>
	a.node,
	a.editor,
<?php endif ?>
	ud.data,
	ud.username,
	ud.email,
	np.uid,
	uc.uid,
	uc.email,
	uc.username,
	uc.data,
	ue.uid,
	ue.email,
	ue.username,
	ue.data,
	t.handle,
	h.handle
<?php if (isset($order)) : ?>
ORDER BY <?= $order ?>
<?php endif ?>
<?php if (isset($limit)) : ?>

LIMIT :limit
<?php endif ?>
<?php if (isset($offset)) : ?>

OFFSET :offset
<?php endif ?>;
