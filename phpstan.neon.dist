includes:
	- vendor/celema/quma/phpstan/extension.neon

parameters:
	level: 8
	paths:
		- src
	# Site developers pass config and attributes that only docblocks type; keep validating them.
	treatPhpDocTypesAsCertain: false
	checkMissingOverrideMethodAttribute: true
	# Their __get() serves registry-defined schema keys, node meta, and block fields.
	universalObjectCratesClasses:
		- Cosray\Collection\Schema
		- Cosray\Node\Meta
		- Cosray\Node\Schema
		- Cosray\Node\Type
		- Cosray\Value\Block
	ignoreErrors:
		-
			# Its subclasses narrow current() to Image and TranslatedFile; an
			# Iterator<int, File> tag would type their iteration as File.
			identifier: missingType.generics
			path: src/Value/Files.php
